# Copy to .env (compose directory or repo root) — never commit real secrets.

# Official docs quickstart: disable DB auth for trusted local lab only.
USE_DB_AUTHENTICATION=false

# PostgreSQL (must match nuq-postgres service). Prefer >=32 random chars for password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
POSTGRES_DB=postgres

# Published API port on host (bound to 127.0.0.1 in this companion's image compose)
PORT=3002

# Image tags for compose/docker-compose.images.yml
# Official docs pin git tag v2.11.162 for source build.
# GHCR: firecrawl has :2.11.162 and :latest; playwright-service / nuq-postgres often only :latest.
FIRECRAWL_IMAGE_TAG=latest
PLAYWRIGHT_IMAGE_TAG=latest
NUQ_POSTGRES_IMAGE_TAG=latest

# Lab-friendly resource caps (raise on a real VPS)
API_MEM_LIMIT=2500m
PLAYWRIGHT_MEM_LIMIT=1500m
NUM_WORKERS_PER_QUEUE=2
CRAWL_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_JOBS=2
BROWSER_POOL_SIZE=1

# Optional: outbound proxy for scraping targets / npm inside containers
# PROXY_SERVER=http://host.docker.internal:7890
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Optional AI features (extract / LLM formats) — leave empty for basic scrape
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api

# Queue admin UI key — set a strong value if you enable admin routes
# BULL_AUTH_KEY=

# Host proxy for git clone / docker pull (outside compose)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
